      "label": "四阶段 Agent",
      "sublabel": "内建自评审"
    },
    {
      "id": "store",
      "type": "database",
      "label": "PMAgentStore",
      "sublabel": "文件事实源"
    },
    {
      "id": "user",
      "type": "external",
      "label": "用户",
      "sublabel": "App 内确认闸口"
    }
  ],
  "segments": [
    {
      "from": 146,
